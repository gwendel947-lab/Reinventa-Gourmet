generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id              Int             @id @default(autoincrement())
  nome            String          @db.VarChar(100)
  email           String          @unique @db.VarChar(150)
  senha           String          @db.VarChar(255)
  avatar          String?         @db.LongText
  nivelHabilidade NivelHabilidade @default(INICIANTE)
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  perfil      PerfilAlimentar?
  inventario  Inventario[]
  receitas    Receita[]
  postagens   Postagem[]
  comentarios Comentario[]
  favoritos   Favorito[]
  geracoes    ReceitaGeracao[]

  @@map("usuarios")
}

enum NivelHabilidade {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

// ─────────────────────────────────────────
// Perfil Alimentar
// ─────────────────────────────────────────

model PerfilAlimentar {
  id           Int       @id @default(autoincrement())
  usuarioId    Int       @unique
  tipoDieta    TipoDieta @default(ONIVORO)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  usuario    Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  restricoes RestricaoAlimentar[]

  @@map("perfis_alimentares")
}

enum TipoDieta {
  ONIVORO
  VEGETARIANO
  VEGANO
  PESCATARIANO
  CETOGENICO
  OUTRO
}

// Uma linha por restrição — permite múltiplas restrições por usuário
model RestricaoAlimentar {
  id       Int    @id @default(autoincrement())
  perfilId Int
  tipo     String @db.VarChar(100) // ex: "sem glúten", "sem lactose"

  perfil PerfilAlimentar @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@map("restricoes_alimentares")
}

// ─────────────────────────────────────────
// Ingredientes (tabela normalizada)
// ─────────────────────────────────────────

model Ingrediente {
  id                  Int     @id @default(autoincrement())
  nome                String  @unique @db.VarChar(150)
  categoria           String  @db.VarChar(100) // ex: "laticínios", "grãos", "legumes"
  classificacaoStatus String  @default("NAO_VERIFICADO") @db.VarChar(30)
  dietasPermitidas    String? @db.Text
  restricoes          String? @db.Text

  inventarios         Inventario[]
  receitaIngredientes ReceitaIngrediente[]

  @@map("ingredientes")
}

// ─────────────────────────────────────────
// Inventário do usuário
// ─────────────────────────────────────────

model Inventario {
  id            Int    @id @default(autoincrement())
  usuarioId     Int
  ingredienteId Int
  quantidade    Float
  unidade       String @db.VarChar(30) // ex: "g", "ml", "unidade", "xícara"

  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id])

  @@unique([usuarioId, ingredienteId])
  @@map("inventario")
}

// ─────────────────────────────────────────
// Receitas
// ─────────────────────────────────────────

model Receita {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  titulo        String   @db.VarChar(200)
  modoPreparo   String   @db.Text
  tempoEstimado Int // em minutos
  porcoes       Int      @default(1)
  imagem        String?  @db.LongText
  publica       Boolean  @default(true)
  geradaPorIA   Boolean  @default(false) // flag para quando a IA for integrada
  criadaEm      DateTime @default(now())
  atualizadaEm  DateTime @updatedAt

  usuario      Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ingredientes ReceitaIngrediente[]
  postagens    Postagem[]
  comentarios  Comentario[]
  favoritos    Favorito[]

  @@map("receitas")
}

model Favorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  receitaId Int
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, receitaId])
  @@map("favoritos")
}

model ReceitaGeracao {
  id               Int       @id @default(autoincrement())
  usuarioId        Int
  chaveCache       String    @db.VarChar(191)
  modelo           String    @db.VarChar(100)
  status           String    @db.VarChar(30)
  payload          Json?
  consumo          Json?
  erroCodigo       String?   @db.VarChar(50)
  receitaId        Int?
  cacheExpiraEm    DateTime?
  rascunhoExpiraEm DateTime?
  criadaEm         DateTime  @default(now())
  finalizadaEm     DateTime?
  duracaoMs        Int?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadaEm])
  @@index([usuarioId, chaveCache])
  @@index([receitaId])
  @@map("receita_geracoes")
}

// ─────────────────────────────────────────
// Receita ↔ Ingredientes (N:N)
// ─────────────────────────────────────────

model ReceitaIngrediente {
  receitaId     Int
  ingredienteId Int
  quantidade    Float
  unidade       String  @db.VarChar(30)
  opcional      Boolean @default(false)

  receita     Receita     @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id])

  @@id([receitaId, ingredienteId])
  @@map("receita_ingredientes")
}

model Comentario {
  id           Int      @id @default(autoincrement())
  receitaId    Int
  usuarioId    Int
  respostaDeId Int?
  texto        String   @db.Text
  criadoEm     DateTime @default(now())

  receita    Receita      @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  usuario    Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  respostaDe Comentario?  @relation("RespostasComentario", fields: [respostaDeId], references: [id], onDelete: Cascade)
  respostas  Comentario[] @relation("RespostasComentario")

  @@index([receitaId, criadoEm])
  @@map("comentarios")
}

// ─────────────────────────────────────────
// Postagens da comunidade
// ─────────────────────────────────────────

model Postagem {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  receitaId   Int?
  imagemPrato String?  @db.VarChar(500) // URL da imagem
  comentario  String?  @db.Text
  criadaEm    DateTime @default(now())

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receita Receita? @relation(fields: [receitaId], references: [id], onDelete: SetNull)

  @@map("postagens")
}
