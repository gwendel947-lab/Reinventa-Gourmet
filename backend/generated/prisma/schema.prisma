generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id              Int             @id @default(autoincrement())
  nome            String          @db.VarChar(100)
  email           String          @unique @db.VarChar(150)
  senha           String          @db.VarChar(255)
  nivelHabilidade NivelHabilidade @default(INICIANTE)
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  perfil     PerfilAlimentar?
  inventario Inventario[]
  receitas   Receita[]
  postagens  Postagem[]

  @@map("usuarios")
}

enum NivelHabilidade {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

// ─────────────────────────────────────────
// Perfil Alimentar
// ─────────────────────────────────────────

model PerfilAlimentar {
  id           Int       @id @default(autoincrement())
  usuarioId    Int       @unique
  tipoDieta    TipoDieta @default(ONIVORO)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  usuario    Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  restricoes RestricaoAlimentar[]

  @@map("perfis_alimentares")
}

enum TipoDieta {
  ONIVORO
  VEGETARIANO
  VEGANO
  PESCATARIANO
  CETOGENICO
  OUTRO
}

// Uma linha por restrição — permite múltiplas restrições por usuário
model RestricaoAlimentar {
  id       Int    @id @default(autoincrement())
  perfilId Int
  tipo     String @db.VarChar(100) // ex: "sem glúten", "sem lactose"

  perfil PerfilAlimentar @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@map("restricoes_alimentares")
}

// ─────────────────────────────────────────
// Ingredientes (tabela normalizada)
// ─────────────────────────────────────────

model Ingrediente {
  id        Int    @id @default(autoincrement())
  nome      String @unique @db.VarChar(150)
  categoria String @db.VarChar(100) // ex: "laticínios", "grãos", "legumes"

  inventarios         Inventario[]
  receitaIngredientes ReceitaIngrediente[]

  @@map("ingredientes")
}

// ─────────────────────────────────────────
// Inventário do usuário
// ─────────────────────────────────────────

model Inventario {
  id            Int    @id @default(autoincrement())
  usuarioId     Int
  ingredienteId Int
  quantidade    Float
  unidade       String @db.VarChar(30) // ex: "g", "ml", "unidade", "xícara"

  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id])

  @@unique([usuarioId, ingredienteId])
  @@map("inventario")
}

// ─────────────────────────────────────────
// Receitas
// ─────────────────────────────────────────

model Receita {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  titulo        String   @db.VarChar(200)
  modoPreparo   String   @db.Text
  tempoEstimado Int // em minutos
  porcoes       Int      @default(1)
  publica       Boolean  @default(true)
  geradaPorIA   Boolean  @default(false) // flag para quando a IA for integrada
  criadaEm      DateTime @default(now())
  atualizadaEm  DateTime @updatedAt

  usuario      Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ingredientes ReceitaIngrediente[]
  postagens    Postagem[]

  @@map("receitas")
}

// ─────────────────────────────────────────
// Receita ↔ Ingredientes (N:N)
// ─────────────────────────────────────────

model ReceitaIngrediente {
  receitaId     Int
  ingredienteId Int
  quantidade    Float
  unidade       String  @db.VarChar(30)
  opcional      Boolean @default(false)

  receita     Receita     @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id])

  @@id([receitaId, ingredienteId])
  @@map("receita_ingredientes")
}

// ─────────────────────────────────────────
// Postagens da comunidade
// ─────────────────────────────────────────

model Postagem {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  receitaId   Int?
  imagemPrato String?  @db.VarChar(500) // URL da imagem
  comentario  String?  @db.Text
  criadaEm    DateTime @default(now())

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  receita Receita? @relation(fields: [receitaId], references: [id], onDelete: SetNull)

  @@map("postagens")
}
